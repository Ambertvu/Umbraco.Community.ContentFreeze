<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- The package targets the lowest 18.x on purpose; consumers resolve their own (patched) Umbraco version. Capped below 19 until it is tested there. -->
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Umbraco.Cms" Version="18.2.2" />
    <PackageVersion Include="Umbraco.Cms.Web.Website" Version="[18.0.0, 19.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="[18.0.0, 19.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Api.Common" Version="[18.0.0, 19.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="[18.0.0, 19.0.0)" />
    <!-- The lowest version Umbraco 18.0 uses; the composer uses its types directly. -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
    <PackageVersion Include="Hangfire.Core" Version="1.8.0" />
    <PackageVersion Include="Umbraco.Forms.Core" Version="[18.0.0, 19.0.0)" />
    <PackageVersion Include="Umbraco.Forms" Version="18.2.2" />
    <PackageVersion Include="Umbraco.Commerce" Version="18.1.9" />
    <PackageVersion Include="Umbraco.Commerce.Cms.Startup" Version="[18.0.0, 19.0.0)" />
    <PackageVersion Include="Umbraco.AI.Core" Version="[18.0.0, 19.0.0)" />
    <PackageVersion Include="Umbraco.AI" Version="18.6.1" />
    <PackageVersion Include="Umbraco.AI.Prompt" Version="18.4.0" />
    <PackageVersion Include="Umbraco.AI.OpenAI" Version="18.3.1" />
    <PackageVersion Include="uSync" Version="18.2.0" />
    <PackageVersion Include="Cultiv.Hangfire" Version="5.5.5" />
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Umbraco.AI.Web" Version="18.6.1" />
    <PackageVersion Include="Umbraco.AI.Prompt.Web" Version="18.4.0" />
    <PackageVersion Include="Umbraco.AI.Agent.Web" Version="18.4.1" />
  </ItemGroup>

</Project>
